# Build context for the server image is the repo root (see CI deploy step).
# The server bundles the shared engine from frontend/src/lib, so that stays in;
# the rest of the frontend (build artifacts, static assets) is excluded.
**/node_modules
**/dist
**/.svelte-kit
frontend/build
frontend/static
.git
.github
# The SQLite data dir only - NOT frontend/src/lib/data (the engine's game data).
server/data
**/*.sqlite
**/*.log
**/.env
**/.env.*
